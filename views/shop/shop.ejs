<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/product.css">
</head>
<body>
  <%- include('../includes/navigation.ejs') %>
  <main> 
      <% if(path === '/') { %>
        <% if(loginSuccess) {%>
          <div class="user-message"><%= loginSuccess %></div>
        <%}%>
        <h1>My Index</h1>
      <% } else { %>
        <h1>My Products</h1>
      <%}%>
      <% if(data.length > 0) { %>
        <div class="grid">
          <% for(let dts of data) { %>
            <article class="card product-item">
              <header class="card__header">
                <h1 class="product__title"> <%= dts.title %> </h1>
              </header>
              <div class="card__image">
                <img src="/<%= dts.imageUrl %>" alt="<%= dts.title %>">
              </div>
              <div class="card__content">
                <h2 class="product__price">$<%= dts.price %></h2>
                <p class="product__description"><%= dts.description %></p>
              </div>
              <div class="card__actions">
                <a class="btn" href="/product/<%= dts._id %>">Details</a>
                <%- include('../includes/addToCart.ejs', { data: dts }) %>
              </div>
            </article>
          <% } %>
        </div>
        <section class="pagination">
          <a href="?page=1">1</a>
          <a href="?page=2">2</a>
        </section>
      <% } else { %>
        <h1>No Product Found</h1>
      <% } %>
  </main>
<%- include('../includes/end.ejs') %>

