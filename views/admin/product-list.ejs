<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/product.css">
</head>
<body>
  <%- include('../includes/navigation.ejs') %>
  <main>
    <% if(data.length > 0) { %>
      <div class="grid">
        <% for(let dts of data) { %>
          <article class="card product-item">
            <header class="card__header">
              <h1 class="product__title"> <%= dts.title %> </h1>
            </header>
            <div class="card__image">
              <img src="/<%= dts.imageUrl %>" alt="<%= dts.title %>">
            </div>
            <div class="card__content">
              <h2 class="product__price">$<%= dts.price %></h2>
              <p class="product__description"><%= dts.description %></p>
            </div>
            <div class="card__actions">
              <a href="/admin/edit-product/<%=dts._id%>?edit=true" class="btn">Edit</a>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" value="<%=dts._id%>" name="id">
              <button class="btn" onclick="deleteProduct(this)" type="submit">Delete</button>
            </div>
          </article>
        <% } %>
      </div>

    <% } else { %>
      <h1>No Product Found</h1>
    <% } %>
  </main>
<%- include('../includes/end.ejs') %>
<script src="/js/admin.js">

</script>